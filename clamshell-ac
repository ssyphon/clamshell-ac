#!/bin/sh
# Lid closed on AC: keep running, screen off. On battery: sleep as normal.
# Runs as root from /Library/LaunchDaemons/com.ssyphon.clamshell-ac.plist; checks every 2s.
cur=
while :; do
  if pmset -g batt | head -1 | grep -q "AC Power"; then ac=1; else ac=0; fi
  ioreg -r -k AppleClamshellState -d 1 | grep -q '"AppleClamshellState" = Yes' && shut=1 || shut=0
  if [ "$ac" != "$cur" ]; then
    pmset -a disablesleep "$ac" && cur=$ac
    logger -t clamshell-ac "disablesleep $ac"
    # unplugged with the lid already shut: sleep now rather than run hot in a bag
    [ "$ac" = 0 ] && [ "$shut" = 1 ] && logger -t clamshell-ac "lid shut on battery, sleeping" && pmset sleepnow
  fi
  # macOS leaves the panel lit behind a closed lid when sleep is disabled; keep it dark
  [ "$ac" = 1 ] && [ "$shut" = 1 ] && pmset displaysleepnow
  sleep 2
done
